{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timtang/vdog/contracts/firmware-release-v1.schema.json",
  "title": "vdog firmware release manifest v1",
  "description": "Release manifest contract for vdog XIAO ESP32S3 Sense installation bundles (docs/plans/0.9-firmware-ci-release.md section 4, docs/plans/0.9-round1-assignment.md). The normative executable mirror is tools/firmware/contract.py; both must reject the same fixtures.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "package_format_version",
    "product",
    "product_slug",
    "hardware_class",
    "board",
    "environment",
    "target",
    "expected_flash_bytes",
    "firmware_version",
    "release_channel",
    "hardware_verified",
    "recording_available",
    "device_ota_available",
    "source",
    "build_id",
    "tag",
    "ci",
    "toolchain",
    "flash",
    "images",
    "partition_table",
    "flash_layout_file",
    "files"
  ],
  "properties": {
    "schema": { "const": "firmware-release-v1" },
    "package_format_version": { "const": 1 },
    "product": { "const": "vdog" },
    "product_slug": { "const": "vdog-xiao-sense" },
    "hardware_class": { "const": "seeed-xiao-esp32s3-sense" },
    "board": { "const": "seeed_xiao_esp32s3" },
    "environment": { "const": "vdog_xiao_sense_proto" },
    "target": { "const": "esp32s3" },
    "expected_flash_bytes": { "const": 8388608 },
    "firmware_version": { "const": "0.2.0-proto" },
    "release_channel": { "const": "prototype" },
    "hardware_verified": { "const": false },
    "recording_available": { "const": false },
    "device_ota_available": { "const": false },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sha", "sha_short", "dirty"],
      "properties": {
        "kind": { "enum": ["pr", "main", "local"] },
        "sha": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|local)$" },
        "sha_short": { "type": "string", "pattern": "^(?:[0-9a-f]{12}|local)$" },
        "pr_number": { "type": ["integer", "null"], "minimum": 1, "maximum": 2147483647 },
        "base_sha": { "type": ["string", "null"], "pattern": "^(?:[0-9a-f]{40}|local)$" },
        "dirty": { "const": false }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "pr" } }, "required": ["kind"] },
          "then": {
            "required": ["kind", "sha", "sha_short", "dirty", "pr_number", "base_sha"],
            "properties": {
              "sha": { "pattern": "^[0-9a-f]{40}$" },
              "sha_short": { "pattern": "^[0-9a-f]{12}$" },
              "pr_number": { "type": "integer" },
              "base_sha": { "pattern": "^[0-9a-f]{40}$" }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "main" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "sha": { "pattern": "^[0-9a-f]{40}$" },
              "sha_short": { "pattern": "^[0-9a-f]{12}$" },
              "pr_number": { "const": null },
              "base_sha": { "const": null }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "local" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "sha": { "const": "local" },
              "sha_short": { "const": "local" },
              "pr_number": { "const": null },
              "base_sha": { "const": null }
            }
          }
        }
      ]
    },
    "build_id": {
      "type": "string",
      "pattern": "^(?:pr-[0-9]{1,9}-[0-9a-f]{12}|main-[0-9a-f]{12}|local)$"
    },
    "tag": {
      "type": ["string", "null"],
      "pattern": "^firmware-main-[0-9a-f]{12}$"
    },
    "ci": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["run_id", "attempt"],
      "properties": {
        "run_id": { "type": "integer", "minimum": 1 },
        "attempt": { "type": "integer", "minimum": 1 }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platformio_core", "platform", "idf_version", "esptool_version"],
      "properties": {
        "platformio_core": { "type": "string", "minLength": 1, "maxLength": 64 },
        "platform": { "const": "platformio/espressif32@8.0.0" },
        "idf_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "esptool_version": { "const": "5.4.0" }
      }
    },
    "flash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "size", "freq", "size_bytes"],
      "properties": {
        "mode": { "const": "dio", "description": "Frozen round-1 baseline; esptool also accepts qio/dout/qout but the release contract pins dio." },
        "size": { "const": "8MB" },
        "freq": { "const": "80m" },
        "size_bytes": { "const": 8388608 }
      }
    },
    "images": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "file", "offset", "size", "sha256"],
        "properties": {
          "role": { "enum": ["bootloader", "partition_table", "ota_data_initial", "application"] },
          "file": { "$ref": "#/$defs/relativePath" },
          "offset": { "type": "integer", "minimum": 0 },
          "size": { "type": "integer", "minimum": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "partition_table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "size", "entries"],
      "properties": {
        "file": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1 },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type", "subtype", "offset", "size"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Za-z0-9_\\-]{1,16}$" },
              "type": { "enum": ["app", "data"] },
              "subtype": {
                "enum": [
                  "boot", "ota_0", "ota_1", "ota_2", "ota_3", "ota_4", "ota_5",
                  "ota_6", "ota_7", "ota_8", "ota_9", "ota_10", "ota_11",
                  "ota_12", "ota_13", "ota_14", "ota_15",
                  "nvs", "ota", "phy", "coredump", "nvs_key", "fat", "spiffs", "any"
                ]
              },
              "offset": { "type": "integer", "minimum": 0 },
              "size": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "flash_layout_file": { "$ref": "#/$defs/relativePath" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/relativePath" },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "source": { "properties": { "kind": { "const": "main" } }, "required": ["kind"] } },
        "required": ["source"]
      },
      "then": { "properties": { "tag": { "type": "string" } } },
      "else": { "properties": { "tag": { "const": null } } }
    },
    {
      "if": {
        "properties": { "source": { "properties": { "kind": { "const": "local" } }, "required": ["kind"] } },
        "required": ["source"]
      },
      "then": {
        "properties": { "ci": { "const": null } },
        "description": "A local build is unpublishable: no tag, no CI identity."
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*[/]$)[A-Za-z0-9 ._/-]+$",
      "minLength": 1,
      "maxLength": 255
    }
  }
}
